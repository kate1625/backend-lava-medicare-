# Copy this file to .env and update the values below

# Application Settings
APP_NAME=MediCare+
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=medicare_plus
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL_CA=
DB_SSL_VERIFY=true

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
# API session duration in seconds (default: 28800 = 8 hours; allowed: 300-43200).
MEDICARE_ACCESS_TOKEN_TTL=28800

# EmailJS server-side email settings for registration and password reset.
# Verification template variables: {{to_email}}, {{to_name}}, {{verification_code}}, {{app_name}}, {{expires_in_minutes}}
# Password reset template variables: {{to_email}}, {{to_name}}, {{reset_url}}, {{app_name}}, {{expires_in_minutes}}
# Appointment template variables: {{to_email}}, {{patient_name}}, {{appointment_id}}, {{service_name}}, {{appt_date}}, {{appt_time}}, {{status}}, {{app_name}}
EMAILJS_SERVICE_ID=
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
EMAILJS_APPOINTMENT_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Public URL of the Vue frontend used in email links.
FRONTEND_URL=http://localhost:5174
# Comma-separated exact browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5174
# PayMongo checkout test integration. Use a test secret key only.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
# Comma-separated checkout methods enabled for your PayMongo account.
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,card
# Optional CA bundle override; defaults to app/config/certs/mozilla-cacert.pem
EMAILJS_CA_BUNDLE=

# Brevo transactional email settings for clinic and patient notifications.
# Verify this sender in Brevo before sending. Keep the API key server-side.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MediCare+
# Clinic admin recipient for booking and payment alerts.
ADMIN_NOTIFICATION_EMAIL=medicareplus.dental666@gmail.com
# Generate a long random secret for the scheduled same-day reminder request.
BREVO_REMINDER_TOKEN=
# Optional CA bundle override; defaults to app/config/certs/mozilla-cacert.pem
BREVO_CA_BUNDLE=
